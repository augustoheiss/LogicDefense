# ============================================================
# Sekundo Backend — Environment Variables
# ============================================================
# This file is ISOLATED from Assistente-Moeda.
# Sekundo has its own deployment, its own URL, its own config.
# DO NOT reference VITE_API_URL or X-Spreadsheet-Key here.
# ============================================================

# The public URL where this backend is deployed (Render)
# Example: https://sekundo-api.onrender.com
SEKUNDO_API_URL=http://localhost:8001

# CORS: comma-separated list of allowed frontend origins
SEKUNDO_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional: Secret key for admin-level API operations
# (NOT a database credential — just a simple API guard)
SEKUNDO_ADMIN_KEY=change-me-in-production

# Port for local development
PORT=8001
