{
  "expo": {
    "name": "Sekundo - Finanças e Rotinas",
    "slug": "assistente-moeda",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "sekundo",
      "assistentemoeda"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.logicdefense.assistentemoeda",
      "buildNumber": "3",
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.heisslab.assistentemoeda",
      "versionCode": 27,
      "adaptiveIcon": {
        "backgroundColor": "#12151C",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12151C",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/app-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "444742d2-f4df-4a57-a412-98ede4bd6e1d"
      }
    },
    "owner": "augustoheiss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/444742d2-f4df-4a57-a412-98ede4bd6e1d"
    }
  }
}
