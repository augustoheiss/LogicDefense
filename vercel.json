{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/signal/:path*",
      "destination": "https://ocorrencias-pdf-writer.onrender.com/signal/:path*"
    },
    {
      "source": "/laboratorio/assistente-moeda/:path*",
      "destination": "/laboratorio/assistente-moeda/index.html"
    },
    {
      "source": "/laboratorio/sekundo/:path*",
      "destination": "/laboratorio/sekundo/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
