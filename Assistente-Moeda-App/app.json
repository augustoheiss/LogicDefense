{
  "expo": {
    "name": "Assistente Moeda",
    "slug": "assistente-moeda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "assistentemoeda",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.logicdefense.assistentemoeda",
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.heisslab.assistentemoeda",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1117",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/laboratorio/assistente-moeda"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "444742d2-f4df-4a57-a412-98ede4bd6e1d"
      }
    },
    "owner": "augustoheiss"
  }
}