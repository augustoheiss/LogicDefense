{
  "expo": {
    "name": "Assistente Moeda",
    "slug": "assistente-moeda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "assistentemoeda",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.logicdefense.assistentemoeda",
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.heisslab.assistentemoeda",
      "adaptiveIcon": {
        "backgroundColor": "#12151C",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12151C",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/app-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "extraDependencies": [
              "com.android.billingclient:billing:8.0.0"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/laboratorio/assistente-moeda"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "444742d2-f4df-4a57-a412-98ede4bd6e1d"
      }
    },
    "owner": "augustoheiss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/444742d2-f4df-4a57-a412-98ede4bd6e1d"
    }
  }
}